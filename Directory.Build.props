<Project>
  <Import Project="Directory.Build.user.props"
          Condition="Exists('Directory.Build.user.props')" />
  <PropertyGroup>
    <!-- May also be supplied as -p:GamePath=... or BOXROOM_GAME_PATH. -->
    <GamePath Condition="'$(GamePath)' == ''">$(BOXROOM_GAME_PATH)</GamePath>
  </PropertyGroup>
</Project>
